# Copy to .env.local for local development.
# In Vercel: Project → Settings → Environment Variables

# MongoDB (Prisma) — allow network access from anywhere for Vercel, or add Vercel IPs in Atlas
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sopflow?retryWrites=true&w=majority"

# NextAuth — REQUIRED in production
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-at-least-32-chars"
NEXTAUTH_URL="https://your-app.vercel.app"

# Optional Google OAuth (also set NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true to show buttons)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"
